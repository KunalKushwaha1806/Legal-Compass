# ── Legal Compass · Node.js Backend Environment Configuration Template ──

# Database Configuration (Optional: Leave blank to automatically use local SQLite fallback)
# Neon.tech PostgreSQL Connection String:
DATABASE_URL=postgresql://username:password@ep-xxxx-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Security Secret for JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here

# Python Colab GPU FastAPI / ngrok URL (Optional: Leave blank to use local Python NLP engine)
PYTHON_API_URL=https://your-ngrok-url.ngrok-free.app

# Express Server Port
PORT=3001

# Allowed CORS Frontend URL
FRONTEND_URL=http://localhost:5173

# Environment (development / production)
NODE_ENV=development
