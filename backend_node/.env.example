# ── Legal Compass · Node.js Backend Environment Configuration Template ──

# Database Configuration (required in production so user accounts persist)
# Render PostgreSQL internal connection string or another managed PostgreSQL URL:
DATABASE_URL=postgresql://username:password@ep-xxxx-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Security Secret for JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here

# Python FastAPI service URL (optional only when the local Python engine is available)
PYTHON_API_URL=https://your-ngrok-url.ngrok-free.app

# Express Server Port
PORT=3001

# Allowed CORS frontend URL. Use a comma-separated list for more than one custom domain.
FRONTEND_URL=http://localhost:5173

# Environment (development / production)
NODE_ENV=development
